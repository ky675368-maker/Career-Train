/* ── NAV CONFIG ── */
const NAV = [
  { id:"home",     label:"Home",    icon:"🏠" },
  { id:"roadmap",  label:"Roadmap", icon:"🗺️" },
  { id:"mentor",   label:"Mentor",  icon:"🤖" },
  { id:"jobs",     label:"Jobs",    icon:"💼" },
  { id:"more",     label:"More",    icon:"⚡" },
];

/* ── ROOT ── */
export default function App() {
  const [user, setUser] = useState(null);
  const [tab,  setTab]  = useState("home");

  const render = () => {
    const p = { user };
    switch(tab){
      case "home":    return <Home     {...p}/>;
      case "roadmap": return <Roadmap  {...p}/>;
      case "mentor":  return <Mentor   {...p}/>;
      case "jobs":    return <Jobs/>;
      case "more":    return <More     {...p}/>;
      default:        return <Home     {...p}/>;
    }
  };

  if (!user) return (
    <>
      <style>{css}</style>
      <div className="app-shell"><Onboarding onDone={setUser}/></div>
    </>
  );

  return (
    <>
      <style>{css}</style>
      <div className="app-shell">
        {/* fake status bar */}
        <div className="status-bar">
          <span className="mono" style={{ fontSize:13, color:C.sub }}>9:41</span>
          <span className="mono" style={{ fontSize:11, color:C.accent, letterSpacing:1 }}>CAREERWISE AI</span>
          <div style={{ display:"flex", gap:8, alignItems:"center" }}>
            <div className="pulse" style={{ width:6, height:6, borderRadius:"50%", background:C.green }}/>
            <span style={{ fontSize:14 }}>🔋</span>
          </div>
        </div>

        {/* page */}
        <div className="page-area" key={tab}>
          {render()}
        </div>

        {/* bottom nav */}
        <div className="bottom-nav">
          {NAV.map(n => (
            <button key={n.id} className={`nav-btn ${tab===n.id?"active":""}`} onClick={() => setTab(n.id)}>
              <span className="nav-icon">{n.icon}</span>
              <span className="nav-label">{n.label}</span>
              {tab===n.id && <div className="nav-dot"/>}
            </button>
          ))}
        </div>
      </div>
    </>
  );
}
