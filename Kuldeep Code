const Jobs = () => {
  const [filter, setFilter] = useState("All");
  const jobs = [
    { title:"Junior Data Analyst", company:"Flipkart",  loc:"Bangalore", sal:"₹6–9 LPA",  match:82, type:"Full-time",  tags:["SQL","Excel","Python"], icon:"🛒" },
    { title:"Data Science Intern", company:"Paytm",     loc:"Remote",    sal:"₹25K/mo",   match:91, type:"Internship", tags:["Python","ML"],          icon:"💳" },
    { title:"Business Analyst",    company:"Accenture", loc:"Pune",      sal:"₹7–11 LPA", match:75, type:"Full-time",  tags:["SQL","Tableau"],        icon:"🌐" },
    { title:"ML Trainee",          company:"Infosys",   loc:"Hyderabad", sal:"₹5–7 LPA",  match:60, type:"Full-time",  tags:["Python","TF"],          icon:"🔵" },
    { title:"Freelance Analyst",   company:"Upwork",    loc:"Remote",    sal:"$15–35/hr", match:78, type:"Freelance",  tags:["SQL","Power BI"],       icon:"💻" },
  ];
  const tc = { "Full-time":C.accent, "Internship":C.green, "Freelance":C.pink };
  const filtered = filter==="All" ? jobs : jobs.filter(j => j.type===filter);

  return (
    <div className="scroll" style={{ padding:"0 0 16px" }}>
      <TopBar title="Jobs" right={<span style={{ fontSize:12, color:C.sub }}>{jobs.length} matches</span>}/>
      <div style={{ padding:"0 16px", display:"flex", flexDirection:"column", gap:14 }}>
        <input className="field" placeholder="🔍  Search jobs, companies..."/>

        <div style={{ display:"flex", gap:7, overflowX:"auto", paddingBottom:2 }}>
          {["All","Full-time","Internship","Freelance"].map(f => (
            <button key={f} onClick={() => setFilter(f)} style={{ padding:"8px 16px", borderRadius:99, border:`1px solid ${filter===f?C.accent:C.border}`, background: filter===f?"rgba(61,239,233,.1)":C.surface, color: filter===f?C.accent:C.sub, fontSize:12, cursor:"pointer", whiteSpace:"nowrap", fontFamily:"DM Sans", transition:"all 0.2s" }}>{f}</button>
          ))}
        </div>

        {filtered.map((j,i) => (
          <div key={i} className={`card fu`} style={{ padding:18, animationDelay:`${i*50}ms` }}>
            <div style={{ display:"flex", gap:12, marginBottom:12 }}>
              <div style={{ width:44, height:44, borderRadius:13, background:C.surface, display:"flex", alignItems:"center", justifyContent:"center", fontSize:22, flexShrink:0 }}>{j.icon}</div>
              <div style={{ flex:1 }}>
                <div style={{ fontSize:15, fontWeight:600 }}>{j.title}</div>
                <div style={{ fontSize:12, color:C.sub }}>{j.company} · {j.loc}</div>
              </div>
              <div style={{ textAlign:"right" }}>
                <div style={{ fontSize:15, fontWeight:700, color: j.match>=80?C.green:C.accent, fontFamily:"Syne" }}>{j.match}%</div>
                <div style={{ fontSize:10, color:C.sub }}>match</div>
              </div>
            </div>

            <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:12 }}>
              <span style={{ fontSize:14, fontWeight:600, color:C.green }}>{j.sal}</span>
              <span className="chip" style={{ background:`${tc[j.type]}18`, color:tc[j.type] }}>{j.type}</span>
            </div>

            <div style={{ display:"flex", gap:6, flexWrap:"wrap", marginBottom:14 }}>
              {j.tags.map(t => <span key={t} className="chip" style={{ background:C.surface, color:C.sub, border:`1px solid ${C.border}` }}>{t}</span>)}
            </div>

            <div style={{ marginBottom:14 }}>
              <div style={{ display:"flex", justifyContent:"space-between", fontSize:12, color:C.sub, marginBottom:5 }}>
                <span>AI Match</span><span style={{ color: j.match>=80?C.green:C.accent, fontWeight:600 }}>{j.match}%</span>
              </div>
              <div className="pbar"><div className="pfill" style={{ width:`${j.match}%`, background: j.match>=80?C.green:C.accent }}/></div>
            </div>

            <div style={{ display:"flex", gap:10 }}>
              <button className="btn-glow" style={{ flex:1, fontSize:14, padding:"12px" }}>Apply Now</button>
              <button className="btn-ghost" style={{ padding:"12px 14px" }}>🔖</button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

