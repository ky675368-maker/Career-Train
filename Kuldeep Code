/* ── RING ── */
const Ring = ({ pct, size = 80, color = C.accent, label, sub }) => {
  const r = (size - 10) / 2;
  const circ = 2 * Math.PI * r;
  return (
    <div style={{ display:"flex", flexDirection:"column", alignItems:"center", gap:5 }}>
      <div style={{ position:"relative", width:size, height:size }}>
        <svg width={size} height={size}>
          <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={C.border} strokeWidth={7}/>
          <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth={7}
            strokeDasharray={circ}
            strokeDashoffset={circ - (pct/100)*circ}
            strokeLinecap="round"
            transform={`rotate(-90 ${size/2} ${size/2})`}
            style={{ transition:"stroke-dashoffset 1.2s ease" }}/>
        </svg>
        <div style={{ position:"absolute", inset:0, display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center" }}>
          <span style={{ fontSize:size>70?15:12, fontWeight:700, color, fontFamily:"Syne" }}>{pct}%</span>
          {sub && <span style={{ fontSize:9, color:C.sub }}>{sub}</span>}
        </div>
      </div>
      {label && <span style={{ fontSize:10, color:C.sub, textAlign:"center" }}>{label}</span>}
    </div>
  );
};

/* ── ONBOARDING ── */
const STEPS = [
  { id:"type",     q:"Who are you?",             opts:["🎓 Student","💼 Job Seeker","🏢 Working Professional"] },
  { id:"name",     q:"What's your name?",         input:true, ph:"Your full name" },
  { id:"field",    q:"Primary interest?",         opts:["💻 Tech & AI","📊 Data Science","🎨 Design & UX","📈 Business","🏥 Healthcare","🔧 Engineering"] },
  { id:"goal",     q:"Dream job / career goal?",  input:true, ph:"e.g. Data Scientist at Google" },
  { id:"timeline", q:"Target timeline?",          opts:["3 months","6 months","12 months","2 years","5+ years"] },
  { id:"budget",   q:"Monthly learning budget?",  opts:["Free only","Under ₹1K","₹1K–5K","₹5K–20K","₹20K+"] },
];

const Onboarding = ({ onDone }) => {
  const [step, setStep] = useState(0);
  const [data, setData] = useState({});
  const cur = STEPS[step];

  const pick = (val) => {
    const d = { ...data, [cur.id]: val };
    setData(d);
    if (step < STEPS.length - 1) setTimeout(() => setStep(s => s + 1), 160);
    else onDone(d);
  };

  return (
    <div style={{ flex:1, display:"flex", flexDirection:"column", padding:"20px 20px 32px", overflowY:"auto" }}>
      {/* progress */}
      <div style={{ display:"flex", gap:4, marginBottom:32 }}>
        {STEPS.map((_,i) => (
          <div key={i} style={{ flex:1, height:3, borderRadius:2, background: i<=step ? C.accent : C.border, transition:"background 0.3s" }}/>
        ))}
      </div>

      <div className="mono" style={{ fontSize:11, color:C.accent, marginBottom:8 }}>STEP {step+1} / {STEPS.length}</div>
      <h2 className="syne fu" key={step} style={{ fontSize:26, lineHeight:1.25, marginBottom:28 }}>{cur.q}</h2>

      {cur.opts ? (
        <div style={{ display:"flex", flexDirection:"column", gap:10 }}>
          {cur.opts.map(o => (
            <button key={o} className={`opt-btn ${data[cur.id]===o?"sel":""}`} onClick={() => pick(o)}>{o}</button>
          ))}
        </div>
      ) : (
        <div style={{ display:"flex", flexDirection:"column", gap:12 }}>
          <input className="field" placeholder={cur.ph} value={data[cur.id]||""}
            onChange={e => setData({...data,[cur.id]:e.target.value})}
            style={{ fontSize:16, padding:"16px" }} autoFocus/>
          <button className="btn-glow" onClick={() => pick(data[cur.id]||"")}>
            {step < STEPS.length-1 ? "Continue →" : "Launch My Navigator 🚀"}
          </button>
        </div>
      )}

      {step > 0 && (
        <button className="btn-ghost" style={{ marginTop:20 }} onClick={() => setStep(s => s-1)}>← Back</button>
      )}
    </div>
  );
};

