/* ── AI MENTOR ── */
const Mentor = ({ user }) => {
  const first = (user.name||"there").split(" ")[0];
  const [msgs, setMsgs] = useState([
    { r:"ai", t:`Hi ${first}! 👋 I'm your AI career mentor. Your goal is to become a ${user.goal||"Data Scientist"} in ${user.timeline||"12 months"}. What can I help with today?` }
  ]);
  const [inp, setInp] = useState("");
  const [loading, setLoading] = useState(false);
  const endRef = useRef();
  const qs = ["What to learn first?","Am I on track?","Motivate me 💪","Jobs I can apply now?"];

  const send = async (txt) => {
    const msg = txt || inp.trim();
    if (!msg) return;
    setInp("");
    setMsgs(p => [...p, { r:"user", t:msg }]);
    setLoading(true);
    try {
      const history = msgs.map(m => ({ role: m.r==="ai"?"assistant":"user", content: m.t }));
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({
          model:"claude-sonnet-4-20250514",
          max_tokens:500,
          system:`You are an expert AI Career Mentor. User: Name=${user.name}, Type=${user.type||"Student"}, Goal=${user.goal||"Data Scientist"}, Timeline=${user.timeline||"12 months"}, Budget=${user.budget||"moderate"}, Field=${user.field||"Tech"}. Give short, warm, practical advice in 2-3 sentences. Use max 1 emoji.`,
          messages:[...history,{ role:"user", content:msg }]
        })
      });
      const d = await res.json();
      setMsgs(p => [...p, { r:"ai", t: d.content?.[0]?.text || "Let me think... try again?" }]);
    } catch {
      setMsgs(p => [...p, { r:"ai", t:"Connection issue. Please retry." }]);
    }
    setLoading(false);
    setTimeout(() => endRef.current?.scrollIntoView({ behavior:"smooth" }), 100);
  };

  return (
    <div style={{ display:"flex", flexDirection:"column", height:"100%", overflow:"hidden" }}>
      <TopBar title="AI Mentor" right={
        <div style={{ display:"flex", alignItems:"center", gap:6 }}>
          <div className="pulse" style={{ width:7, height:7, borderRadius:"50%", background:C.green }}/>
          <span style={{ fontSize:12, color:C.sub }}>Online</span>
        </div>
      }/>

      <div style={{ flex:1, overflowY:"auto", padding:"8px 16px 8px", display:"flex", flexDirection:"column", gap:14 }}>
        {msgs.map((m,i) => (
          <div key={i} style={{ display:"flex", justifyContent: m.r==="user"?"flex-end":"flex-start", gap:10, alignItems:"flex-end" }}>
            {m.r==="ai" && (
              <div style={{ width:32, height:32, borderRadius:10, background:`linear-gradient(135deg,${C.purple},${C.accent})`, display:"flex", alignItems:"center", justifyContent:"center", fontSize:16, flexShrink:0 }}>🤖</div>
            )}
            <div className="bubble" style={{
              background: m.r==="user" ? `linear-gradient(135deg,${C.purple},${C.purple}cc)` : C.card,
              border: m.r==="ai" ? `1px solid ${C.border}` : "none",
              borderBottomRightRadius: m.r==="user" ? 4 : 18,
              borderBottomLeftRadius:  m.r==="ai"  ? 4 : 18,
            }}>{m.t}</div>
          </div>
        ))}
        {loading && (
          <div style={{ display:"flex", gap:10, alignItems:"flex-end" }}>
            <div style={{ width:32, height:32, borderRadius:10, background:`linear-gradient(135deg,${C.purple},${C.accent})`, display:"flex", alignItems:"center", justifyContent:"center" }}>🤖</div>
            <div className="bubble" style={{ background:C.card, border:`1px solid ${C.border}` }}>
              <span className="pulse" style={{ color:C.sub }}>● ● ●</span>
            </div>
          </div>
        )}
        <div ref={endRef}/>
      </div>

      <div style={{ padding:"8px 16px", display:"flex", gap:7, overflowX:"auto", borderTop:`1px solid ${C.border}` }}>
        {qs.map(q => (
          <button key={q} className="btn-ghost" style={{ fontSize:12, padding:"7px 13px", whiteSpace:"nowrap" }} onClick={() => send(q)}>{q}</button>
        ))}
      </div>

      <div style={{ padding:"10px 16px 14px", display:"flex", gap:10 }}>
        <input className="field" placeholder="Ask your mentor..." value={inp}
          onChange={e => setInp(e.target.value)}
          onKeyDown={e => e.key==="Enter" && send()}
          style={{ flex:1 }}/>
        <button className="btn-glow" style={{ width:"auto", padding:"0 18px", fontSize:18 }} onClick={() => send()}>➤</button>
      </div>
    </div>
  );
};

